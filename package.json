{
  "name": "paymentrequired-wallet",
  "version": "0.76.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "Wallet service of paymentrequired.com: the agent Safe wallet tool for AI agents (wallet.paymentrequired.com)",
  "scripts": {
    "start": "node src/wallet-server.mjs",
    "build:privy": "esbuild public/privy-bridge.jsx --bundle --minify --format=iife --platform=browser --target=es2022 --outfile=public/privy-bridge.js",
    "precheck": "for f in src/*.mjs public/short-link.mjs; do node --check \"$f\" || exit 1; done",
    "check": "npm run precheck && node scripts/check-import-closure.mjs",
    "check:ask": "node --experimental-test-module-mocks scripts/check-wallet-ask.mjs",
    "check:ask:regression": "node scripts/check-wallet-ask-regression.mjs",
    "check:prf": "node scripts/check-prf-arkade-v2.mjs && node scripts/check-cross-rail-v2.mjs && node scripts/check-solana-x402.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@arkade-os/sdk": "0.5.8",
    "@arkade-os/swap": "0.1.8",
    "@noble/ciphers": "1.2.1",
    "@privy-io/node": "0.33.0",
    "@solana-program/token": "0.9.0",
    "@solana/kit": "5.5.1",
    "@x402/core": "2.23.0",
    "@x402/evm": "2.23.0",
    "@x402/svm": "2.23.0",
    "@zerodev/ecdsa-validator": "5.4.9",
    "@zerodev/permissions": "5.6.3",
    "@zerodev/sdk": "5.5.7",
    "ethers": "^6.16.0",
    "mppx": "0.8.19",
    "nostr-tools": "2.24.1",
    "ox": "0.14.33",
    "viem": "2.56.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@privy-io/react-auth": "3.38.0",
    "esbuild": "0.28.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "overrides": {
    "axios": "1.18.0",
    "viem": {
      "ws": "8.21.0"
    }
  }
}
