# Wallet service (wallet.paymentrequired.com). Names only; real values live on the box (0600).
# Production values per role: see DEPLOY.md. Every name below is read by code cited next to it.

# --- process -------------------------------------------------------------------
SERVICE_MODE=wallet                    # src/wallet-server.mjs:42; anything else refuses to boot
HOST=127.0.0.1                         # src/wallet-server.mjs:53
# SERVICE_PORT=8798                    # src/service-mode.mjs:12,20 (default 8798)
PUBLIC_ORIGIN=http://localhost:8798    # src/wallet-server.mjs:57; prod https://wallet.paymentrequired.com
BASE_PATH=                             # src/browser-bridge.mjs:141
# CORS_EXTRA_ORIGINS=                  # src/wallet-server.mjs:58

# --- state (bind-mounted, private) -----------------------------------------------
SHORT_LINKS_DB=state/wallet.sqlite     # src/wallet-server.mjs:64; also opens <db>.chain-<id> (src/mcp-agent-wallet.mjs:225)
AGENT_STORE_PATH=state/agent-wallets.sqlite   # src/server-boot-check.mjs:9, src/privy-agent-app-signer.mjs:93

# --- agent custody (required at boot, src/server-boot-check.mjs:6-15) -------------
AGENT_CUSTODY_MODEL=nuri-privy-app-2of2
PRIVY_AGENT_APP_ID=
PRIVY_AGENT_APP_SECRET=
PRIVY_AGENT_AUTHORIZATION_PRIVATE_KEY=
AGENT_KERNEL_ALPHA=true                # src/mcp-agent-wallet.mjs:215
AGENT_KERNEL_RPC_URL=                  # src/agent-kernel-runtime.mjs:169
AGENT_KERNEL_GAS_BUDGET_WEI=           # src/agent-kernel-runtime.mjs:148
AGENT_KERNEL_FUNDER_KEY_FILE=/run/agent-kernel-funder.key   # src/agent-kernel-runtime.mjs:310
WALLET_FUND_REFILL_PRIVATE_KEY=        # src/mcp-wallet-fund-reserve.mjs:83 (sandbox chain only)
CIRCLE_GATEWAY_API_KEY=                # src/agent-kernel-runtime.mjs:728

# --- public Privy root app (approval page) ----------------------------------------
PRIVY_APP_ID=
PRIVY_CLIENT_ID=

# --- chain / AA ---------------------------------------------------------------------
AA_CHAIN_ID=8453
WIREX_CHAIN_ID=8453                    # chain id fallback only (src/aa-register.mjs:115); no Wirex client here
AA_PUBLIC_RPC_URL=
AA_BUNDLER_RPC_URL=
AA_PAYMASTER_ADDRESS=
AA_PAYMASTER_KIND=

# --- private peers (loopback, src/service-rpc.mjs:51) --------------------------------
SERVICE_RPC_SECRET=                    # >= 32 chars (src/service-rpc.mjs:22)
BANKING_RPC_URL=http://127.0.0.1:8796
LEGACY_RPC_URL=http://127.0.0.1:8795

# --- root signer broker consumer "wallet" (optional; unset = local taps only) ---------
# ROOT_SIGNER_URL=http://127.0.0.1:8797
# ROOT_SIGNER_CREDENTIAL=
# ROOT_SIGNER_RESULT_KEY_FILE=/run/root-signer-result.key

# --- tool prices (optional; unset = all free) ------------------------------------------
# TOOL_PRICES_JSON=
# TOOL_PRICE_PAYTO=

# NEVER here (refused at boot, src/service-mode.mjs:24-28):
# WIREX_TOKEN_URL, WIREX_COMPANY_ID, WIREX_CLIENT_ID, WIREX_CLIENT_SECRET
